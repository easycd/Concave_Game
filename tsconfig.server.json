{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "build",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["server/*.ts", "src/shared.ts", "src/renju.ts"],
  "exclude": ["server/*.test.ts"]
}
